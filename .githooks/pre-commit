#!/bin/sh
# Pre-commit secret scan for this repo.
# One-time setup per clone:   git config core.hooksPath .githooks
# Requires gitleaks:           go install github.com/zricethezav/gitleaks/v8@v8.24.3
#                              (or: brew install gitleaks / winget install gitleaks)
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit unscanned changes." >&2
  echo "  install:  go install github.com/zricethezav/gitleaks/v8@v8.24.3" >&2
  echo "  CI runs the same scan, so a bypass (git commit --no-verify) only delays the failure." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner || exit 1
# Maintainer clones also run a supplementary private gitleaks rule file. It
# sits beside the repo metadata so one copy serves every worktree; without it
# this step is skipped.
guard="$(git rev-parse --git-common-dir)/name-guard.toml"
if [ -f "$guard" ]; then
  gitleaks git --pre-commit --staged --redact --no-banner --config "$guard" || exit 1
fi
