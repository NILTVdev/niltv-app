{
  "name": "@niltv/backend",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "NILTV AWS backend — CDK stacks (foundation/api/edge) + Lambda handlers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth -c stage=dev",
    "deploy:dev": "cdk deploy -c stage=dev --all --require-approval never",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-cloudfront": "^3.1092.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1093.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-firehose": "^3.1091.0",
    "@aws-sdk/client-mediaconvert": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/client-scheduler": "^3.1092.0",
    "@aws-sdk/client-sesv2": "^3.1125.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/client-sqs": "^3.1127.0",
    "@aws-sdk/client-ssm": "^3.1102.0",
    "@aws-sdk/cloudfront-signer": "^3.1125.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@niltv/types": "*",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1093.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
