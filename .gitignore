coverage/

# Partner content API: the CloudFront signing PUBLIC keys are safe and required at synth
!backend/lib/keys/*.pub.pem

# local backfill / probe reports
backend/backfill-*.json

# maintainer scripts copied in for a single run; never committed
backend/scripts/_local_*
