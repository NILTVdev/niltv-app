# NIL TV Portal. Copy to .env.local (gitignored) and fill in the stage values.

# Portal API base URL: the PortalApiUrl output of the portal stack. No trailing slash.
VITE_PORTAL_API=

# The niltv.com Cognito user pool, e.g. us-east-1_XXXXXXXXX
VITE_COGNITO_POOL_ID=

# A Cognito app client the portal API accepts (no client secret).
VITE_COGNITO_CLIENT_ID=

# dev or prod. Anything other than prod shows a stage badge next to the logo.
VITE_STAGE=dev
